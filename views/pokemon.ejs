<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ポケモン図鑑</title>
</head>
<body>
  <h1>ポケモン図鑑</h1>
  <p>初期データは全国図鑑No.0001〜0009です。</p>
  <table>
    <thead><tr><th>図鑑番号</th><th>名前</th><th>タイプ</th></tr></thead>
    <tbody>
    <% for (const row of data) { %>
      <tr>
        <td><%= String(row.number).padStart(4, '0') %></td>
        <td><a href="/pokemon/<%= row.number %>"><%= row.name %></a></td>
        <td><%= row.type %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <p><a href="/public/pokemon_add.html">ポケモンを追加</a></p>
  <p><a href="/public/index.html">トップへ戻る</a></p>
</body>
</html>
